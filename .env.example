# QualityWaterAlert — Variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs.
# .env ne doit jamais être commité (il est dans .gitignore).

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Environnement ASP.NET Core : Production | Development
ASPNETCORE_ENVIRONMENT=Production

# ---------------------------------------------------------------------------
# Alertes email (SMTP) — optionnel, requis uniquement si les alertes sont activées
# ---------------------------------------------------------------------------

# Serveur SMTP (ex. smtp.gmail.com, smtp.sendgrid.net, smtp.mail.ovh.net)
SMTP_HOST=smtp.example.com

# Port SMTP : 587 (STARTTLS, recommandé) | 465 (SSL) | 25 (non chiffré)
SMTP_PORT=587

# Adresse email expéditrice
SMTP_FROM_EMAIL=noreply@example.com

# Nom affiché dans le champ "De :"
SMTP_FROM_NAME=QualityWaterAlert

# Identifiants SMTP (laisser vide si le serveur n'exige pas d'authentification)
SMTP_USERNAME=
SMTP_PASSWORD=

# ---------------------------------------------------------------------------
# Cloudflare Tunnel — optionnel, uniquement si vous utilisez l'Option A (accès externe)
# ---------------------------------------------------------------------------

# Token généré dans Cloudflare Zero Trust → Tunnels
CLOUDFLARE_TUNNEL_TOKEN=
