@inject IDataProvider DataProvider
@inject IHttpClientFactory HttpClientFactory
@using System.Text.Json.Serialization

<MudAutocomplete T="Commune"
                 Placeholder="@(_isInitializing ? "Chargement des communes…" : "Commune (ex : Paris) ou code postal (ex : 92500)")"
                 SearchFunc="SearchCommunes"
                 ToStringFunc="@(c => c?.Name ?? string.Empty)"
                 ValueChanged="HandleSelection"
                 Disabled="_isInitializing"
                 Clearable="true"
                 ResetValueOnEmptyText="true"
                 CoerceValue="false"
                 MinCharacters="@MinQueryLength"
                 MaxItems="@MaxResults"
                 AdornmentIcon="@Icons.Material.Filled.Search"
                 Adornment="Adornment.Start"
                 Variant="Variant.Outlined"
                 FullWidth="true">
    <ItemTemplate Context="commune">
        <MudText>
            <strong>@commune.Name</strong>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Inline="true" Class="ms-2">
                Dept. @commune.DepartmentCode &middot; INSEE @commune.INSEECode
            </MudText>
        </MudText>
    </ItemTemplate>
</MudAutocomplete>

@code {
    [Parameter] public EventCallback<Commune> OnCommuneSelected { get; set; }
    [Parameter] public int MinQueryLength { get; set; } = 2;
    [Parameter] public int MaxResults { get; set; } = 15;

    private CommuneSearcher? _searcher;
    private bool _isInitializing = true;

    protected override async Task OnInitializedAsync()
    {
        var communes = await DataProvider.GetAllCommunesAsync();
        _searcher = new CommuneSearcher(communes);
        _isInitializing = false;
    }

    private async Task<IEnumerable<Commune>> SearchCommunes(string value, CancellationToken ct)
    {
        if (_searcher is null || value.Length < MinQueryLength)
            return Enumerable.Empty<Commune>();

        if (IsPostalCode(value))
        {
            if (value.Length == 5)
            {
                var fromApi = await ResolvePostalCodeAsync(value, ct);
                if (fromApi.Any()) return fromApi;
            }
            return _searcher.SearchByPostalCode(value, MaxResults);
        }

        return _searcher.SearchByName(value, MaxResults);
    }

    private async Task<IEnumerable<Commune>> ResolvePostalCodeAsync(string postalCode, CancellationToken ct)
    {
        try
        {
            var client = HttpClientFactory.CreateClient();
            var geoCommunes = await client.GetFromJsonAsync<GeoCommune[]>(
                $"https://geo.api.gouv.fr/communes?codePostal={postalCode}&fields=code,nom",
                ct);
            if (geoCommunes is null) return [];

            return geoCommunes
                .Select(g => _searcher!.FindByINSEECode(g.Code))
                .OfType<Commune>()
                .ToList();
        }
        catch
        {
            return [];
        }
    }

    private async Task HandleSelection(Commune? commune)
    {
        if (commune is not null)
            await OnCommuneSelected.InvokeAsync(commune);
    }

    private static bool IsPostalCode(string input) =>
        input.Length >= 2 && input.All(char.IsDigit);

    private record GeoCommune(
        [property: JsonPropertyName("code")] string Code,
        [property: JsonPropertyName("nom")] string Nom);
}
