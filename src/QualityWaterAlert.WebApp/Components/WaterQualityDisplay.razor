@if (IsLoading)
{
    <div class="text-center py-5">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-3">Récupération des données qualité…</MudText>
    </div>
}
else if (Analysis is not null)
{
    @* ---- Conformity banner ---- *@
    <MudAlert Severity="@(Analysis.OverallConformity == 'C' ? Severity.Success : Severity.Error)" Class="mb-4" role="status">
        <MudStack Spacing="0">
            <MudText Typo="Typo.subtitle1"><strong>@Analysis.Commune.Name</strong></MudText>
            <MudText Typo="Typo.body2">
                @(Analysis.OverallConformity == 'C'
                    ? "Eau conforme aux normes en vigueur"
                    : "Eau non conforme — des anomalies ont été détectées")
            </MudText>
            @if (Oldest is not null && Latest is not null)
            {
                <MudText Typo="Typo.caption">
                    Données du @Oldest.SamplingDate.ToString("dd/MM/yyyy") au @Latest.SamplingDate.ToString("dd/MM/yyyy")
                </MudText>
            }
        </MudStack>
    </MudAlert>

    @* ---- Stats cards + Donut chart ---- *@
    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="12" md="8">
            <MudGrid Spacing="3">
                <MudItem xs="6">
                    <MudCard Elevation="1">
                        <MudCardContent Class="text-center pa-4">
                            <div class="wqd-stat-value mud-primary-text">@Analysis.TotalSamplings</div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Prélèvements</MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="6">
                    <MudCard Elevation="1">
                        <MudCardContent Class="text-center pa-4">
                            <div class="wqd-stat-value mud-success-text">@Analysis.ConformSamplings</div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Conformes</MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="6">
                    <MudCard Elevation="1">
                        <MudCardContent Class="text-center pa-4">
                            <div class="wqd-stat-value @(Analysis.NonConformSamplings > 0 ? "mud-error-text" : "mud-success-text")">
                                @Analysis.NonConformSamplings
                            </div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Non-conformes</MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="6">
                    <MudCard Elevation="1">
                        <MudCardContent Class="text-center pa-4">
                            <div class="wqd-stat-value @PctColor">@Analysis.ConformityPercentage&nbsp;%</div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Taux de conformité</MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            </MudGrid>
        </MudItem>

        <MudItem xs="12" md="4" Class="d-flex justify-center align-center">
            <ConformityDonutChart ConformCount="@Analysis.ConformSamplings"
                                  TotalCount="@Analysis.TotalSamplings" />
        </MudItem>
    </MudGrid>

    @* ---- Problematic parameters ---- *@
    @if (Problematic.Count > 0)
    {
        <MudCard Elevation="1" Class="mb-4">
            <MudCardHeader Class="wqd-danger-header">
                <CardHeaderContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" Size="Size.Small" />
                        <strong>Paramètres non conformes</strong>
                    </MudStack>
                </CardHeaderContent>
            </MudCardHeader>
            <div class="overflow-x-auto">
                <table class="wqa-table wqa-table-sm">
                    <thead>
                        <tr>
                            <th>Paramètre</th>
                            <th class="text-end pe-3">Dépassements</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (_, name, count) in Problematic)
                        {
                            <tr>
                                <td>@name</td>
                                <td class="text-end pe-3">
                                    <span class="wqa-badge wqa-badge--danger wqa-badge--pill">@count</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </MudCard>
    }

    @* ---- Recent samplings ---- *@
    @if (RecentSamplings.Count > 0)
    {
        <MudCard Elevation="1" Class="mb-4">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <strong>Prélèvements récents</strong>
                        @if (Analysis.TotalSamplings > MaxSamplings)
                        {
                            <span class="wqa-badge wqa-badge--secondary">@MaxSamplings / @Analysis.TotalSamplings</span>
                        }
                    </MudStack>
                </CardHeaderContent>
            </MudCardHeader>
            <div class="overflow-x-auto">
                <table class="wqa-table wqa-table-sm">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Réseau</th>
                            <th class="text-center">Bactério.</th>
                            <th class="text-center">Chimique</th>
                            <th class="text-center">Paramètres</th>
                            <th class="text-center">Statut</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in RecentSamplings)
                        {
                            <tr class="@(s.IsNonConform ? "wqa-row-danger" : "")">
                                <td class="text-nowrap">@s.SamplingDate.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Inline="true">
                                        @(string.IsNullOrWhiteSpace(s.NetworkCode) ? "—" : s.NetworkCode)
                                    </MudText>
                                </td>
                                <td class="text-center">
                                    <ComplianceIndicator ConformityStatus="s.BacterioConformity" ShowLabel="false" Size="sm" />
                                </td>
                                <td class="text-center">
                                    <ComplianceIndicator ConformityStatus="s.ChemicalConformity" ShowLabel="false" Size="sm" />
                                </td>
                                <td class="text-center">
                                    @if (s.GetNonConformMeasurementCount() > 0)
                                    {
                                        <span class="wqa-badge wqa-badge--danger">@s.GetNonConformMeasurementCount() NC</span>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Inline="true">@s.Measurements.Count</MudText>
                                    }
                                </td>
                                <td class="text-center">
                                    <ComplianceIndicator ConformityStatus="s.GetOverallConformity()" ShowLabel="false" Size="sm" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </MudCard>
    }

    @* ---- Latest measurements ---- *@
    @if (Latest is not null && Latest.Measurements.Count > 0)
    {
        <MudCard Elevation="1">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <strong>Mesures — dernier prélèvement</strong>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@Latest.SamplingDate.ToString("dd/MM/yyyy")</MudText>
                    </MudStack>
                </CardHeaderContent>
            </MudCardHeader>
            <div class="overflow-x-auto">
                <table class="wqa-table wqa-table-sm">
                    <thead>
                        <tr>
                            <th>Paramètre</th>
                            <th>Valeur mesurée</th>
                            <th>Limite réglementaire</th>
                            <th class="text-center">Statut</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Latest.Measurements.OrderBy(m => m.IsConform).ThenBy(m => m.DisplayName))
                        {
                            <tr class="@(m.IsNonConform ? "wqa-row-danger" : "")">
                                <td>@m.DisplayName</td>
                                <td>@m.MeasurementDisplay</td>
                                <td>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Inline="true">
                                        @(string.IsNullOrWhiteSpace(m.QualityLimit) || m.QualityLimit == "X" ? "—" : m.QualityLimit)
                                    </MudText>
                                </td>
                                <td class="text-center">@m.StatusBadge</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </MudCard>
    }
}

@code {
    [Parameter] public WaterQualityAnalysis? Analysis { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public int MaxSamplings { get; set; } = 10;

    private SamplingEvent? Latest => Analysis?.GetLatestSampling();
    private SamplingEvent? Oldest => Analysis?.GetOldestSampling();

    private List<(string Code, string Name, int Count)> Problematic =>
        Analysis?.GetProblematicParameters() ?? [];

    private List<SamplingEvent> RecentSamplings =>
        Analysis?.SamplingEvents
            .OrderByDescending(s => s.SamplingDate)
            .Take(MaxSamplings)
            .ToList() ?? [];

    private string PctColor =>
        (Analysis?.ConformityPercentage ?? 0) >= 95m ? "mud-success-text"
        : (Analysis?.ConformityPercentage ?? 0) >= 75m ? "mud-warning-text"
        : "mud-error-text";
}
