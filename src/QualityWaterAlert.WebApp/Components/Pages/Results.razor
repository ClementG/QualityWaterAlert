@page "/results/{InseeCode}"
@page "/results"
@inject IDataProvider DataProvider
@inject NavigationManager Nav

<PageTitle>@(_analysis?.Commune.Name ?? InseeCode ?? "Résultats") — Quality Water Alert</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-4">

    <MudButton Href="/"
               Variant="Variant.Text"
               Color="Color.Default"
               Size="Size.Small"
               StartIcon="@Icons.Material.Filled.ArrowBack"
               Class="mb-3 px-0">
        Accueil
    </MudButton>

    <div class="results-header mb-4">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap" Spacing="3">
            <div>
                @if (_analysis is not null)
                {
                    <MudText Typo="Typo.h5" Class="mb-1">@_analysis.Commune.Name</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Département @_analysis.Commune.DepartmentCode &middot; Code INSEE @InseeCode
                    </MudText>
                }
                else if (_isLoading)
                {
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="260px" Height="36px" Class="mb-1" />
                }
                else
                {
                    <MudText Typo="Typo.h5" Class="mb-1">Code INSEE : @InseeCode</MudText>
                }
            </div>

            @if (_analysis is not null)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                    <ComplianceIndicator ConformityStatus="_analysis.OverallConformity" Size="lg" />
                    <AlertSubscription Commune="_analysis.Commune" OnSubscribed="HandleSubscribed" />
                </MudStack>
            }
        </MudStack>

        @if (_subscribed && _subscribedEmail is not null)
        {
            <div class="mt-3">
                <AlertConfirmation Email="@_subscribedEmail"
                                   Commune="@_analysis?.Commune"
                                   OnDismiss="DismissConfirmation" />
            </div>
        }

        @if (_errorMessage is not null)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-3">@_errorMessage</MudAlert>
        }
    </div>

    <WaterQualityDisplay Analysis="_analysis" IsLoading="_isLoading" />

</MudContainer>

@code {
    [Parameter] public string? InseeCode { get; set; }

    private WaterQualityAnalysis? _analysis;
    private bool _isLoading;
    private string? _errorMessage;
    private bool _subscribed;
    private string? _subscribedEmail;

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrWhiteSpace(InseeCode))
        {
            Nav.NavigateTo("/");
            return;
        }

        _analysis = null;
        _errorMessage = null;
        _subscribed = false;
        _subscribedEmail = null;
        _isLoading = true;

        try
        {
            _analysis = await DataProvider.GetWaterQualityAnalysisAsync(InseeCode, null, null);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Impossible de charger les données pour le code INSEE \"{InseeCode}\". {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void HandleSubscribed(string email)
    {
        _subscribedEmail = email;
        _subscribed = true;
    }

    private void DismissConfirmation()
    {
        _subscribed = false;
        _subscribedEmail = null;
    }
}
