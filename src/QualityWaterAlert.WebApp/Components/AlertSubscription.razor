@inject IDialogService DialogService

<MudButton Variant="Variant.Outlined"
           StartIcon="@Icons.Material.Filled.NotificationsNone"
           OnClick="OpenDialogAsync"
           aria-label="S'abonner aux alertes qualité eau">
    Alertes
</MudButton>

@code {
    [Parameter] public Commune? Commune { get; set; }
    [Parameter] public EventCallback<string> OnSubscribed { get; set; }

    private async Task OpenDialogAsync()
    {
        var parameters = new DialogParameters<AlertSubscriptionDialog>
        {
            { x => x.Commune, Commune }
        };
        var dialog = await DialogService.ShowAsync<AlertSubscriptionDialog>(
            "S'abonner aux alertes",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: string email })
            await OnSubscribed.InvokeAsync(email);
    }
}
